<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.xiaohua</groupId>
    <artifactId>star-knowledge-assistant</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>star-knowledge-assistant</name>
    <description>智能星知识助手</description>
    <properties>
        <java.version>21</java.version>
        <!--
          LangChain4j 版本。core / 聚合模块走稳定线，各集成是同一版本的 beta 后缀。
          两个属性必须【一起】升级：集成模块的 pom 里声明依赖的就是稳定版 core，
          只升一个会导致版本错配。见 knowledge/01-总体架构与路线图.md
        -->
        <langchain4j.version>1.20.0</langchain4j.version>
        <langchain4j.beta.version>1.20.0-beta30</langchain4j.beta.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Redis：邮箱验证码 + 登录态（Spring Session） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
        </dependency>

        <!-- ORM -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 仅引入加密模块，不引入完整 spring-boot-starter-security（避免默认安全拦截） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- 邮件：邮箱注册验证码。即使不用邮箱注册，spring.mail.* 配置也必须存在，
             否则 JavaMailSender bean 不创建，UserServiceImpl 注入失败会导致启动失败 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- 接口文档：knife4j 基于 springdoc -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
            <version>4.4.0</version>
        </dependency>
        <!-- 覆盖 knife4j 4.4.0 内置的 springdoc 2.3.0，兼容 Spring Boot 3.5.x（Spring Framework 6.2） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.17</version>
        </dependency>

        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>5.8.38</version>
        </dependency>
        <!-- 注册策略里用了 org.apache.commons.lang3.StringUtils，显式声明，别靠传递依赖 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.38</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          ============ LangChain4j ============
          注意 core 和聚合模块【职责不同，两个都要显式引】，别只引 core 然后指望传递依赖：
            langchain4j-core → 接口与 SPI（ScoringModel / EmbeddingStore / ChatMemory / TextSegment / DocumentSplitter）
            langchain4j      → 具体实现与服务层（AiServices / MessageWindowChatMemory / @Tool / @MemoryId）
          这个边界容易记错，且类会换模块 —— 升级时回来核对这一块。
        -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-core</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>

        <!-- 本地向量模型：模型文件打进 jar，512 维，零下载零调用成本 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-embeddings-bge-small-zh-v15-q</artifactId>
            <version>${langchain4j.beta.version}</version>
        </dependency>
        <!-- 本地重排模型：只给 ScoringModel 实现，模型文件需单独下载（见 knowledge/21） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-onnx-scoring</artifactId>
            <version>${langchain4j.beta.version}</version>
        </dependency>

        <!-- 向量库 Milvus。这是 legacy 模块（带 milvus-sdk-java:2.5.9，故服务端 2.5.27 不用动）；
             LangChain4j 2.0 会用 langchain4j-milvus-v2 取代它 —— 已知技术债，见 knowledge/01 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-milvus</artifactId>
            <version>${langchain4j.beta.version}</version>
        </dependency>

        <!-- 流式输出（SSE） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-reactor</artifactId>
            <version>${langchain4j.beta.version}</version>
        </dependency>

        <!-- 文档解析：PDF / Word。自身传递引入 pdfbox 3.0.7 与 poi，不需要再手写裸依赖 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-document-parser-apache-pdfbox</artifactId>
            <version>${langchain4j.beta.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-document-parser-apache-poi</artifactId>
            <version>${langchain4j.beta.version}</version>
        </dependency>

        <!--
          暂【不】引 langchain4j-community-dashscope-spring-boot-starter（远端 qwen 对话模型）：
          它是 Spring 自动配置，要求 langchain4j.community.dashscope.chat-model.api-key；
          在没有 DASHSCOPE_API_KEY 的环境里会让整个应用启动失败。
          等做「对话与流式」那个里程碑时再引，并同步补配置。
        -->
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-bom</artifactId>
                <version>3.5.13</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
              onnxruntime 的版本裁决（两个 LC4j 模块声明的版本不一致）：
                langchain4j-embeddings（向量）  声明 1.20.0，深度 2
                langchain4j-onnx-scoring（重排）声明 1.22.0，深度 1
              Maven「取近者」会选 1.22.0 —— 但 1.22.0 的原生库在本机加载失败
              （UnsatisfiedLinkError: 动态链接库(DLL)初始化例程失败），所以显式钉回 1.20.0，
              这也正是 langchain4j-embeddings 自己声明的版本。
              若哪天换机器后 1.22.0 可用，可以去掉这段让它自然解析。
              详见 knowledge/21-本地Embedding与Rerank.md
            -->
            <dependency>
                <groupId>com.microsoft.onnxruntime</groupId>
                <artifactId>onnxruntime</artifactId>
                <version>1.20.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.38</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
